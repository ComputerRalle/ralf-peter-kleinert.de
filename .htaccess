# ============================================================
# .htaccess - ralf-peter-kleinert.de
# ============================================================


# ============================================================
# MOD_REWRITE
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------------------------
    # Kanonische Hauptdomain erzwingen
    # --------------------------------------------------------
    RewriteCond %{HTTP_HOST} !^ralf-peter-kleinert\.de$ [NC]
    RewriteRule ^(.*)$ https://ralf-peter-kleinert.de%{REQUEST_URI} [R=301,L]

    # --------------------------------------------------------
    # Startseiten vereinheitlichen
    # --------------------------------------------------------
    RewriteRule ^index\.html$ https://ralf-peter-kleinert.de/ [R=301,L]
    RewriteRule ^start\.html$ https://ralf-peter-kleinert.de/ [R=301,L]

    # --------------------------------------------------------
    # Alte Suche
    # --------------------------------------------------------
    RewriteRule ^suchen\.html$ /suchen.php [R=301,L]

    # --------------------------------------------------------
    # .html ergänzen, wenn entsprechende Datei existiert
    # Ausnahmen: .txt und .xml
    # --------------------------------------------------------
    RewriteCond %{REQUEST_URI} !\.txt$ [NC]
    RewriteCond %{REQUEST_URI} !\.xml$ [NC]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/.]+)$ /$1.html [R=301,L]
</IfModule>


# ============================================================
# PERMANENTE 301-WEITERLEITUNGEN
# ============================================================

<IfModule mod_alias.c>

    # --------------------------------------------------------
    # Vaultwarden -> Blog
    # --------------------------------------------------------
    Redirect 301 /sicherheit-in-der-it/vaultwarden-ssl-local-network.html https://blog.ralf-peter-kleinert.de/it-sicherheit-und-computersicherheit-fuer-unternehmen-und-privatpersonen/passwortmanager-hochverschluesselt-vaultwarden-im-lan-mit-verschluesselung-und-ssl/


